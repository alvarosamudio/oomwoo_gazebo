<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="pi" value="3.1415926535"/>

  <xacro:property name="wheel_diameter" value="0.065"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_base" value="0.280"/>
  <xacro:property name="wheel_mass" value="0.080"/>

  <xacro:property name="caster_diameter" value="0.020"/>
  <xacro:property name="caster_mass" value="0.020"/>
  <xacro:property name="caster_inset" value="0.030"/>

  <xacro:property name="floor_clearance" value="0.020"/>

  <xacro:property name="base_diameter" value="0.330"/>
  <xacro:property name="base_height" value="0.040"/>
  <xacro:property name="base_mass" value="0.800"/>

  <xacro:property name="top_height" value="0.035"/>
  <xacro:property name="top_mass" value="0.300"/>

  <xacro:property name="lidar_height" value="0.025"/>
  <xacro:property name="lidar_diameter" value="0.050"/>
  <xacro:property name="lidar_mass" value="0.050"/>
  <xacro:property name="lidar_z_offset" value="0.075"/>

  <xacro:property name="bumper_height" value="0.030"/>
  <xacro:property name="bumper_width" value="0.100"/>
  <xacro:property name="bumper_depth" value="0.012"/>
  <xacro:property name="bumper_mass" value="0.020"/>
  <xacro:property name="motor_stall_torque" value="0.5"/>
  <xacro:property name="max_linear_acceleration" value="1.0"/>

  <!-- Cliff sensors (BOM: 4x downward IR). Mounted on the underside of
       base_link, on a circle of cliff_radius, looking straight down. -->
  <xacro:property name="cliff_radius" value="0.140"/>
  <xacro:property name="cliff_front_angle" value="0.35"/>  <!-- ~20 deg -->
  <xacro:property name="cliff_side_angle" value="1.05"/>   <!-- ~60 deg -->
  <xacro:property name="cliff_z" value="-0.002"/>
  <xacro:property name="cliff_range_min" value="0.005"/>
  <xacro:property name="cliff_range_max" value="0.150"/>
  <xacro:property name="cliff_update_rate" value="50"/>
  <xacro:property name="sensor_mass" value="0.002"/>
  <xacro:property name="sensor_size" value="0.008"/>

  <!-- IMU at the base centre -->
  <xacro:property name="imu_z" value="0.010"/>
  <xacro:property name="imu_update_rate" value="100"/>

  <!-- Battery (BOM: 14.4 V 4S2P Li-ion, ~5.2 Ah / 75 Wh) -->
  <xacro:property name="battery_v_full" value="16.8"/>
  <xacro:property name="battery_v_nominal" value="14.4"/>
  <xacro:property name="battery_v_span" value="-4.0"/>     <!-- 16.8 V full -> 12.8 V empty -->
  <xacro:property name="battery_capacity_ah" value="5.2"/>
  <xacro:property name="battery_initial_ah" value="5.2"/>
  <xacro:property name="battery_resistance" value="0.07"/>
  <xacro:property name="battery_power_load" value="30.0"/>  <!-- W, ~2.5 h runtime -->
</robot>
