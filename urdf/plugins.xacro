<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_base}</wheel_separation>
      <wheel_radius>${wheel_diameter/2}</wheel_radius>
      <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
      <topic>cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <dimensions>2</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>

    <!-- Battery: published on /model/oomwoo/battery/main_battery/state
         (gz.msgs.BatteryState), bridged to /battery_state. The model name
         "oomwoo" comes from the spawn command in the launch files.
         Voltage ~= full + span * (1 - charge/capacity) - R * I. -->
    <plugin filename="gz-sim-linearbatteryplugin-system" name="gz::sim::systems::LinearBatteryPlugin">
      <battery_name>main_battery</battery_name>
      <voltage>${battery_v_nominal}</voltage>
      <open_circuit_voltage_constant_coef>${battery_v_full}</open_circuit_voltage_constant_coef>
      <open_circuit_voltage_linear_coef>${battery_v_span}</open_circuit_voltage_linear_coef>
      <initial_charge>${battery_initial_ah}</initial_charge>
      <capacity>${battery_capacity_ah}</capacity>
      <resistance>${battery_resistance}</resistance>
      <smooth_current_tau>2.0</smooth_current_tau>
      <power_load>${battery_power_load}</power_load>
      <start_draining>true</start_draining>
      <fix_issue_225>true</fix_issue_225>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>${imu_update_rate}</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Cliff sensors: a 3-ray downward gpu_lidar each (a single-sample
       gpu_lidar is unreliable). Floor is ~0.018 m below the sensor; a
       reading beyond cliff_detector's threshold (or inf) means a drop. -->
  <xacro:macro name="cliff_sensor_plugin" params="name">
    <gazebo reference="cliff_${name}_link">
      <sensor name="cliff_${name}_sensor" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>${cliff_update_rate}</update_rate>
        <topic>cliff/${name}</topic>
        <gz_frame_id>cliff_${name}_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>3</samples>
              <resolution>1</resolution>
              <min_angle>-0.02</min_angle>
              <max_angle>0.02</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${cliff_range_min}</min>
            <max>${cliff_range_max}</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </ray>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:cliff_sensor_plugin name="front_left"/>
  <xacro:cliff_sensor_plugin name="front_right"/>
  <xacro:cliff_sensor_plugin name="side_left"/>
  <xacro:cliff_sensor_plugin name="side_right"/>

  <gazebo reference="base_scan">
    <sensor name="laser_scan_sensor" type="gpu_lidar">
      <pose relative_to="base_scan">0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>${2*pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="bumper_left_link">
    <sensor name="bumper_left_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>bumper_left_collision</collision>
        <topic>bumper_left</topic>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="bumper_right_link">
    <sensor name="bumper_right_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <contact>
        <collision>bumper_right_collision</collision>
        <topic>bumper_right</topic>
      </contact>
    </sensor>
  </gazebo>
</robot>
